APP_NAME="Noor AlQaseem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
# Port used by `composer dev` / `php artisan serve`
SERVER_PORT=8010

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noor_alqaseem
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production (HTTPS) set both to true:
SESSION_SECURE_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Mail — Microsoft 365 example (SMTP AUTH must be enabled for the mailbox):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=info@n-alqaseem.com
# MAIL_PASSWORD=
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@n-alqaseem.com"
MAIL_FROM_NAME="${APP_NAME}"

# Send an email notification for each contact message (recipient is set in the admin panel).
CONTACT_NOTIFY=false

# Optional Cloudflare Turnstile protection for the contact form (leave empty to disable).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
